{
  "name": "numr-web",
  "version": "0.2.1",
  "description": "Web interface for numr calculator",
  "type": "module",
  "main": "numr-calculator.js",
  "types": "numr-calculator.d.ts",
  "exports": {
    ".": {
      "types": "./numr-calculator.d.ts",
      "default": "./numr-calculator.js"
    }
  },
  "scripts": {
    "clean": "rm -rf pkg",
    "build:core": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build ../crates/numr-core --target web --out-dir ../../numr-web/pkg/core --features wasm",
    "build:editor": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build ../crates/numr-editor --target web --out-dir ../../numr-web/pkg/editor --features wasm",
    "build:wasm": "npm run build:core && npm run build:editor",
    "stamp:assets": "node scripts/stamp-asset-versions.mjs",
    "build": "npm run clean && npm run build:wasm && npm run stamp:assets",
    "serve": "python3 -m http.server 8080",
    "start": "npm run build && npm run serve"
  },
  "keywords": [
    "calculator",
    "wasm",
    "webassembly",
    "numr",
    "web-components",
    "lit",
    "custom-elements"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nasedkinpv/numr-web"
  }
}
